# Môi trường dev/tool — không cần trong build context, loại để build nhanh + image gọn
.venv/
__pycache__/
*.pyc
.pytest_cache/
.claude/
.deepeval/
eval/
docs/
tests/
logs/
.git/
.gitignore

# Frontend: cài lại trong image, không copy node_modules/dist cũ từ máy host
frontend/node_modules/
frontend/dist/

# Bí mật + dữ liệu thật — không được bake vào image, truyền qua env/volume lúc chạy
.env
data/hotel.db
data/hotel.db.bak
data/hotel_view.json

# Editor/OS
.vscode/
*.log
