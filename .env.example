# Provider LLM (OpenAI-compatible, có function-calling). Copy file này thành .env rồi điền giá trị thật.
# .env đã được .gitignore — KHÔNG commit key thật.
LLM_BASE_URL=https://your-provider/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name

# ---------- Vận hành ----------
# Thư mục dữ liệu động (hotel.db, logs). Trên Docker/cloud là chỗ cắm volume: /app/storage
STORAGE_DIR=
# Múi giờ nghiệp vụ (tính "hôm nay" cho đặt phòng/trả phòng)
APP_TZ=Asia/Ho_Chi_Minh
# Tài khoản admin tạo tự động lần đầu (chỉ khi DB chưa có tài khoản nào). Để trống = không tạo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# true khi chạy sau HTTPS (production) — cookie đăng nhập chỉ gửi qua HTTPS
COOKIE_SECURE=false
# false để tắt guardrail khi cần đo latency
GUARDRAIL_ENABLED=true
# Phiên chat (lưu trong RAM, mất khi đóng tab/restart server)
# Phiên không có tin nhắn mới quá số phút này thì bị xóa khỏi RAM
CHAT_IDLE_MINUTES=60
# Trần số phiên chat giữ trong RAM — vượt thì xóa phiên hoạt động cũ nhất
CHAT_MAX_SESSIONS=1000
# true = khách đăng nhập được cả trước ngày nhận phòng (để test/demo). Tắt (false) khi chạy thật.
GUEST_LOGIN_ANYTIME=false
